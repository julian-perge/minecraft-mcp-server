{
  "name": "minecraft-mcp-server",
  "version": "2.0.4",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "main": "dist/main.js",
  "bin": {
    "minecraft-mcp-server": "dist/main.js"
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "nodeArguments": [
      "--import=tsx"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "ava",
    "check:types": "bun check",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "minecraft-data": "^3.105.0",
    "mineflayer": "^4.35.0",
    "mineflayer-pathfinder": "^2.4.2",
    "vec3": "^0.1.8",
    "yargs": "^18.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ava/typescript": "^6.0.0",
    "@types/node": "^25.2.3",
    "@types/sinon": "^21.0.0",
    "@types/vec3": "^0.1.4",
    "@types/yargs": "^17.0.35",
    "ava": "^6.4.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "sinon": "^21.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
